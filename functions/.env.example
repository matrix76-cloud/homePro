# Cloud Functions 환경변수
#
# firebase-tools 는 배포 대상 프로젝트에 맞춰 아래 순서로 읽는다:
#   functions/.env                  (공통)
#   functions/.env.<프로젝트ID>      (프로젝트별 — 이쪽이 우선)
#
# 프로젝트마다 키가 다르므로 프로젝트별 파일을 쓴다. 예:
#   functions/.env.homepro-43f7f    (기존)
#   functions/.env.homepro-9202f    (의뢰인)
#
# 이 파일을 복사해서 값을 채운 뒤 `firebase deploy --only functions` 하면 함께 올라간다.
# 값이 없으면 해당 기능(카카오 로그인 / 문자 발송) 호출 시 에러로 알려준다.

# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_KEY=

# 솔라피 문자 발송 (인증번호) — 솔라피 콘솔 > API Key 관리 / 발신번호는 사전등록된 번호(숫자만)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# 토스페이먼츠 시크릿 키 (보험·구독 결제 승인 / 빌링키 발급·자동결제) — functions/tossPay.js, insurance.js
# 토스 개발자센터 > 내 개발정보 > API 키 > 시크릿 키 (테스트 test_sk_…, 운영 live_sk_…)
# 비워두면 토스 문서 공개 테스트 키(test_gsk_docs_…)로 폴백 — 계약 전 개발용. 실제 돈은 빠지지 않는다. 앞단 REACT_APP_TOSS_CLIENT_KEY 와 한 쌍이어야 한다.
TOSS_SECRET_KEY=
