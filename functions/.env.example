# Cloud Functions 환경변수
#
# firebase-tools 는 배포 대상 프로젝트에 맞춰 아래 순서로 읽는다:
#   functions/.env                  (공통)
#   functions/.env.<프로젝트ID>      (프로젝트별 — 이쪽이 우선)
#
# 프로젝트마다 키가 다르므로 프로젝트별 파일을 쓴다. 예:
#   functions/.env.homepro-43f7f    (기존)
#   functions/.env.homepro-9202f    (의뢰인)
#
# 이 파일을 복사해서 값을 채운 뒤 `firebase deploy --only functions` 하면 함께 올라간다.
# 값이 없으면 해당 기능(카카오 로그인 / 문자 발송) 호출 시 에러로 알려준다.

# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_KEY=

# 문자 발송 게이트웨이 (인증번호 발송)
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=
