# 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 커밋되지 않는다)
#
# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정 및 구성 에서 그대로 복사할 수 있다.

REACT_APP_FB_API_KEY=
REACT_APP_FB_AUTH_DOMAIN=
REACT_APP_FB_PROJECT_ID=
REACT_APP_FB_STORAGE_BUCKET=
REACT_APP_FB_MESSAGING_SENDER_ID=
REACT_APP_FB_APP_ID=
REACT_APP_FB_MEASUREMENT_ID=

# Cloud Functions 배포 리전 (functions/ 배포 리전과 같아야 함)
REACT_APP_FB_FUNCTIONS_REGION=asia-northeast3

# 공유 링크·OG 미리보기에 쓰이는 절대 도메인 (끝에 / 없이)
REACT_APP_PUBLIC_BASE_URL=https://example.web.app

# AI 견적용 Gemini API 키
REACT_APP_GEMINI_API_KEY=

# 카카오 로그인 REST 키 (카카오 개발자 콘솔 > 앱 키)
REACT_APP_KAKAO_REST_KEY=
